# git-annex configuration for this DataLad dataset.
#
# Files matching `annex.largefiles` are stored in git-annex (content-addressed
# and fetchable with `datalad get .`); everything else is committed to plain
# Git so that code, notebooks and configuration stay diffable and reviewable.
* annex.backend=MD5E
* annex.largefiles=(largerthan=100kb)

# Never annex source, notebooks, docs or configuration.
*.ipynb annex.largefiles=nothing
*.md annex.largefiles=nothing
*.py annex.largefiles=nothing
*.txt annex.largefiles=nothing
*.yml annex.largefiles=nothing
*.yaml annex.largefiles=nothing
*.json annex.largefiles=nothing
*.toml annex.largefiles=nothing

# Package metadata listings are small, human-readable tabular files.
*.tsv annex.largefiles=nothing
*.csv annex.largefiles=nothing

# git submodules must never be annexed.
data/repo/** annex.largefiles=nothing
**/.git* annex.largefiles=nothing
